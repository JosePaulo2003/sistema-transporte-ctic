          <mxGeometry x="525" y="610" width="470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p11-n18" value="iniciar.cmd / iniciar.ps1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n17">
          <mxGeometry x="16" y="12" width="438" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n19" value="php -S 127.0.0.1:8080 roteador.php&#xa;Linux: iniciar.sh com comandos/php.sh&#xa;Desenvolvimento local" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n17">
          <mxGeometry x="16" y="54" width="438" height="106" as="geometry" />
