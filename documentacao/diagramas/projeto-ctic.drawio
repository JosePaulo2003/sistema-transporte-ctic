          <mxGeometry x="45" y="610" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p11-n21" value="Validação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n20">
          <mxGeometry x="16" y="12" width="308" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n22" value="PHP: regras isoladas&#xa;Python: integração HTTP&#xa;Playwright: navegador&#xa;Entrega: testes sem banco" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n20">
          <mxGeometry x="16" y="54" width="308" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p11-n23" value="" edge="1" parent="1" source="p11-n5" target="p11-n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-n24" value="" edge="1" parent="1" source="p11-n8" target="p11-n11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-n25" value="" edge="1" parent="1" source="p11-n11" target="p11-n14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-n26" value="configuração válida" edge="1" parent="1" source="p11-n14" target="p11-n17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-n27" value="verificar" edge="1" parent="1" source="p11-n17" target="p11-n20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-n28" value="Hospedagem: DocumentRoot em public/, HTTPS, cookie_seguro=true, ambiente_local=false, remetente e serviço de e-mail configurados. As migrações atuais não contêm dados pessoais. DDL não é&#xa;revertido automaticamente pelo MySQL; faça backup antes de futuras mudanças de estrutura." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#213D30;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="900" width="1570" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ctic-12" name="12 Entrega sem dados locais">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p12-n2" value="12  /  ENTREGA SEM DADOS LOCAIS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1610" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p12-n3" value="O caminho recomendado para compartilhar é o ZIP produzido pelo comando; um ZIP manual da pasta não passa por estas barreiras." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="1610" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p12-n4" value="CTIC  •  Sistema de Transportes  •  Estado documentado em 16/11/2026  •  Sem dados ou credenciais da instalação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#657786;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1055" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p12-n5" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F0F3F5;strokeColor=#657786;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="360" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p12-n6" value="Projeto de trabalho" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n5">
          <mxGeometry x="16" y="12" width="328" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n7" value="Código + modelos + documentação&#xa;Credenciais e configuração privadas&#xa;Logs, mensagens, caches e banco local&#xa;Git e cópias de segurança" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n5">
          <mxGeometry x="16" y="54" width="328" height="146" as="geometry" />
        </mxCell>
        <mxCell id="p12-n8" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="555" y="170" width="490" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p12-n9" value="entrega.py + entrega.json" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n8">
          <mxGeometry x="16" y="12" width="458" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n10" value="Lista de diretórios, arquivos e extensões&#xa;Recusa segredos identificados no conteúdo&#xa;Compara com as senhas locais sem exibi-las&#xa;Recusa vínculos e dumps com dados&#xa;Guarda só código e documentação revisáveis" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n8">
          <mxGeometry x="16" y="54" width="458" height="156" as="geometry" />
        </mxCell>
        <mxCell id="p12-n11" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1205" y="170" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p12-n12" value="entregas/*.zip" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n11">
          <mxGeometry x="16" y="12" width="388" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n13" value="Sem .git, *.local.*, .env ou credenciais&#xa;Sem armazenamento, dumps e backups&#xa;Manifesto com SHA-256 de cada arquivo&#xa;ZIP relido e conferido antes de liberar" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n11">
          <mxGeometry x="16" y="54" width="388" height="156" as="geometry" />
        </mxCell>
        <mxCell id="p12-n14" value="preparar-entrega.cmd" edge="1" parent="1" source="p12-n5" target="p12-n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-n15" value="ZIP verificado" edge="1" parent="1" source="p12-n8" target="p12-n11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-n16" value="CAMADAS PARA GIT" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="535" width="1610" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p12-n17" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F0F3F5;strokeColor=#657786;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="600" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p12-n18" value=".gitignore / .gitattributes" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n17">
          <mxGeometry x="16" y="12" width="408" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n19" value="Ignora arquivos locais na preparação&#xa;export-ignore evita itens no git archive&#xa;Não remove segredos de commits antigos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n17">
          <mxGeometry x="16" y="54" width="408" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p12-n20" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="625" y="600" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p12-n21" value="Gancho pre-commit" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n20">
          <mxGeometry x="16" y="12" width="408" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n22" value="Verifica os bytes do índice Git&#xa;Bloqueia arquivos privados rastreados&#xa;Não confia só no arquivo da pasta." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n20">
          <mxGeometry x="16" y="54" width="408" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p12-n23" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1205" y="600" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p12-n24" value="Gancho pre-push" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n23">
          <mxGeometry x="16" y="12" width="388" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n25" value="Inspeciona os commits a enviar&#xa;Detecta segredo apagado no commit seguinte&#xa;Não reescreve o histórico automaticamente." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n23">
          <mxGeometry x="16" y="54" width="388" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p12-n26" value="git add / commit" edge="1" parent="1" source="p12-n17" target="p12-n20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-n27" value="git push" edge="1" parent="1" source="p12-n20" target="p12-n23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-n28" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#FFF5D8;strokeColor=#A77B16;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="910" width="1580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12-n29" value="Limite da automação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p12-n28">
          <mxGeometry x="16" y="12" width="1548" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p12-n30" value="Os ganchos são locais e podem ser ignorados manualmente; padrões não reconhecem todo dado pessoal em texto livre ou imagem.&#xa;Revise os arquivos permitidos e compartilhe somente o ZIP gerado. As credenciais locais continuam funcionando na sua instalação." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p12-n28">
