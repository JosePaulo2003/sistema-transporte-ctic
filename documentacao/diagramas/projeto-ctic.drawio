        <mxCell id="p4-n30" value="usuario_atual()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p4-n29">
          <mxGeometry x="16" y="12" width="698" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p4-n31" value="Reconsulta usuário ativo e perfil; compara assinatura da senha.&#xa;Expira após 30 minutos de inatividade ou 8 horas de duração (configuráveis)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p4-n29">
