  <diagram id="ctic-11" name="11 Preparação e operação">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p11-n2" value="11  /  PREPARAÇÃO E OPERAÇÃO" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1610" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p11-n3" value="O instalador configura um MySQL existente; o Workbench serve para administrá-lo. Não inclui binários ou dados na entrega." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="1610" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p11-n4" value="CTIC  •  Sistema de Transportes  •  Estado documentado em 16/11/2026  •  Sem dados ou credenciais da instalação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#657786;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1055" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p11-n5" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F0F3F5;strokeColor=#657786;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="180" width="340" height="180" as="geometry" />
