          <mxGeometry x="80" y="865" width="1525" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p6-n33" value="Integridade do histórico" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p6-n32">
          <mxGeometry x="16" y="12" width="1493" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6-n34" value="SELECT ... FOR UPDATE bloqueia o pedido durante a mudança. Status, atendimento e histórico são gravados na mesma transação.&#xa;Pedido alheio retorna 404. Transição proibida retorna 409. Estados terminais não são reabertos pela API." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p6-n32">
          <mxGeometry x="16" y="54" width="1493" height="61" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ctic-7" name="07 Passageiros e privacidade">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7-n2" value="07  /  PASSAGEIROS E PRIVACIDADE" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1610" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p7-n3" value="O catálogo reutilizável e os passageiros de uma viagem têm finalidades e ciclos de vida diferentes." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="1610" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p7-n4" value="CTIC  •  Sistema de Transportes  •  Estado documentado em 16/11/2026  •  Sem dados ou credenciais da instalação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#657786;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1055" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p7-n5" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="55" y="185" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p7-n6" value="Usuário autenticado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p7-n5">
          <mxGeometry x="16" y="12" width="268" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7-n7" value="Cadastro é sempre privado por dono&#xa;Administrador também consulta&#xa;somente seu próprio catálogo" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p7-n5">
          <mxGeometry x="16" y="54" width="268" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p7-n8" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="500" y="185" width="445" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p7-n9" value="cadastros_passageiros" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p7-n8">
          <mxGeometry x="16" y="25" width="413" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7-n10" value="Nome, CPF válido, telefone, setor e vínculo&#xa;CPF ativo único por usuario_id&#xa;GET / POST / PUT / DELETE na API&#xa;DELETE marca ativo=0; não apaga histórico" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p7-n8">
          <mxGeometry x="16" y="67" width="413" height="153" as="geometry" />
        </mxCell>
        <mxCell id="p7-n11" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="185" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p7-n12" value="Seleção para o rascunho" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p7-n11">
          <mxGeometry x="16" y="12" width="438" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7-n13" value="passageiros_ids: inteiros distintos&#xa;Somente cadastros ativos do próprio usuário&#xa;Até 50; zero é aceito apenas no rascunho&#xa;API copia os dados para a sessão" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p7-n11">
          <mxGeometry x="16" y="54" width="438" height="166" as="geometry" />
        </mxCell>
        <mxCell id="p7-n14" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="500" y="630" width="445" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p7-n15" value="passageiros + vínculo da viagem" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p7-n14">
          <mxGeometry x="16" y="25" width="413" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7-n16" value="O envio final cria cópias independentes&#xa;Somente nome, setor, vínculo e usuario_id&#xa;solicitacao_passageiros faz a associação&#xa;Sem FK para o catálogo reutilizável" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p7-n14">
          <mxGeometry x="16" y="67" width="413" height="143" as="geometry" />
        </mxCell>
        <mxCell id="p7-n17" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#FFF5D8;strokeColor=#A77B16;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="660" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p7-n18" value="Editar ou remover depois" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p7-n17">
          <mxGeometry x="16" y="12" width="438" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p7-n19" value="Afeta apenas o catálogo&#xa;As cópias das viagens não mudam&#xa;Passageiros alheios retornam 404" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p7-n17">
          <mxGeometry x="16" y="54" width="438" height="111" as="geometry" />
        </mxCell>
        <mxCell id="p7-n20" value="seu cadastro" edge="1" parent="1" source="p7-n5" target="p7-n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-n21" value="selecionar" edge="1" parent="1" source="p7-n8" target="p7-n11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-n22" value="envio final" edge="1" parent="1" source="p7-n11" target="p7-n14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-n23" value="manutenção" edge="1" parent="1" source="p7-n8" target="p7-n17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-n24" value="não altera" edge="1" parent="1" source="p7-n17" target="p7-n14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-n25" value="A API legada também aceita passageiros informados diretamente no rascunho (nome, setor e vínculo); a interface atual usa o catálogo privado. Nenhum cadastro real ou dump com pessoas deve&#xa;acompanhar a entrega." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#213D30;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="925" width="1545" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ctic-8" name="08 Recuperação e troca de senha">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8-n2" value="08  /  RECUPERAÇÃO E TROCA DE SENHA" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1610" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p8-n3" value="O token bruto aparece somente no link gerado; o banco guarda seu hash. A recuperação não revela se uma conta existe." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="1610" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p8-n4" value="CTIC  •  Sistema de Transportes  •  Estado documentado em 16/11/2026  •  Sem dados ou credenciais da instalação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#657786;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1055" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p8-n5" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="175" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p8-n6" value="Solicitar recuperação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n5">
          <mxGeometry x="16" y="12" width="308" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n7" value="/recuperar-senha&#xa;POST /api/autenticacao/recuperar&#xa;E-mail válido + CSRF" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n5">
          <mxGeometry x="16" y="54" width="308" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p8-n8" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="535" y="175" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p8-n9" value="Servidor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n8">
          <mxGeometry x="16" y="12" width="358" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n10" value="Limite: 5 pedidos por e-mail OU IP&#xa;Janela de 15 minutos&#xa;Mesmo texto para conta inexistente&#xa;Conta existente precisa estar ativa" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n8">
          <mxGeometry x="16" y="54" width="358" height="126" as="geometry" />
        </mxCell>
        <mxCell id="p8-n11" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1090" y="175" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p8-n12" value="recuperacoes_senha" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n11">
          <mxGeometry x="16" y="25" width="488" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n13" value="Token aleatório de 32 bytes (64 hex)&#xa;SHA-256 do token + assinatura do hash da senha&#xa;Expiração em 30 minutos&#xa;Marca de uso impede reutilização" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n11">
          <mxGeometry x="16" y="67" width="488" height="113" as="geometry" />
        </mxCell>
        <mxCell id="p8-n14" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#FFF5D8;strokeColor=#A77B16;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1090" y="530" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p8-n15" value="Entrega da mensagem" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n14">
          <mxGeometry x="16" y="12" width="488" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n16" value="Local: TXT privado em armazenamento/emails&#xa;Externo: mail() com remetente e servidor configurados&#xa;Sem configuração, não há entrega externa." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n14">
          <mxGeometry x="16" y="54" width="488" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p8-n17" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="535" y="530" width="390" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p8-n18" value="Redefinir senha" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n17">
          <mxGeometry x="16" y="12" width="358" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n19" value="/redefinir-senha#token=...&#xa;Token sai da URL após leitura&#xa;POST /api/autenticacao/redefinir&#xa;12–72 bytes + confirmação&#xa;Validação e atualização transacionais" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n17">
          <mxGeometry x="16" y="54" width="358" height="141" as="geometry" />
        </mxCell>
        <mxCell id="p8-n20" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="550" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p8-n21" value="Novo acesso" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p8-n20">
          <mxGeometry x="16" y="12" width="308" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8-n22" value="Hash de senha é substituído&#xa;Todos os tokens pendentes são usados&#xa;Sessões antigas são recusadas&#xa;Usuário entra novamente" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p8-n20">
          <mxGeometry x="16" y="54" width="308" height="111" as="geometry" />
        </mxCell>
        <mxCell id="p8-n23" value="" edge="1" parent="1" source="p8-n5" target="p8-n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#61766B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;">
