          <mxGeometry x="525" y="180" width="470" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p11-n9" value="configurar.cmd / configurar.ps1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n8">
          <mxGeometry x="16" y="12" width="438" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n10" value="Recebe acesso administrativo local&#xa;Cria banco se ele não existe&#xa;Cria uma conta restrita à aplicação&#xa;Gera configuração e acesso locais" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n8">
          <mxGeometry x="16" y="54" width="438" height="136" as="geometry" />
        </mxCell>
        <mxCell id="p11-n11" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1155" y="180" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p11-n12" value="preparar.php → migrar.php" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n11">
          <mxGeometry x="16" y="12" width="428" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n13" value="GET_LOCK evita preparações simultâneas&#xa;Aplica migrações SQL em ordem&#xa;Registra nomes e hashes SHA-256&#xa;Cria administrador somente se não existe" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n11">
          <mxGeometry x="16" y="54" width="428" height="136" as="geometry" />
        </mxCell>
        <mxCell id="p11-n14" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1155" y="595" width="460" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p11-n15" value="MySQL preparado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n14">
          <mxGeometry x="16" y="25" width="428" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n16" value="001: autenticação&#xa;002: solicitações e histórico&#xa;003: catálogo e fluxos completos&#xa;Ledger: migracoes_aplicadas" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n14">
