  <diagram id="ctic-9" name="09 API e autorização">
    <mxGraphModel dx="1700" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1210" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9-n2" value="09  /  API E AUTORIZAÇÃO" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#075C35;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1610" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p9-n3" value="Todas as escritas exigem CSRF. Respostas usam JSON e dados pessoais nunca são retornados sem autorização." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="1610" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p9-n4" value="CTIC  •  Sistema de Transportes  •  Estado documentado em 16/11/2026  •  Sem dados ou credenciais da instalação" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#657786;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1165" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p9-n5" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p9-n6" value="Acesso público + CSRF nas escritas" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n5">
          <mxGeometry x="16" y="12" width="458" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n7" value="GET  /api/autenticacao/csrf&#xa;POST /api/autenticacao/entrar&#xa;POST /api/autenticacao/recuperar&#xa;POST /api/autenticacao/redefinir&#xa;Formatos e limites são validados no servidor." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n5">
          <mxGeometry x="16" y="54" width="458" height="206" as="geometry" />
        </mxCell>
        <mxCell id="p9-n8" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="605" y="170" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p9-n9" value="Usuário autenticado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n8">
          <mxGeometry x="16" y="12" width="458" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n10" value="GET /api/autenticacao/usuario&#xa;POST /api/autenticacao/sair&#xa;GET/PUT /api/conta&#xa;PUT /api/conta/senha&#xa;GET/POST /api/passageiros&#xa;GET/PUT/DELETE /api/passageiros/{id}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n8">
          <mxGeometry x="16" y="54" width="458" height="206" as="geometry" />
        </mxCell>
        <mxCell id="p9-n11" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#E5F4EC;strokeColor=#087443;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1165" y="170" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p9-n12" value="Dono ou administrador: pedidos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n11">
          <mxGeometry x="16" y="12" width="458" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n13" value="GET/POST /api/solicitacoes&#xa;GET/PUT/DELETE /.../rascunho&#xa;GET /api/solicitacoes/{id}&#xa;POST /api/solicitacoes/{id}/cancelar&#xa;Solicitante vê somente seus pedidos." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n11">
          <mxGeometry x="16" y="54" width="458" height="206" as="geometry" />
        </mxCell>
        <mxCell id="p9-n14" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#EAF1FB;strokeColor=#386AA3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="570" width="760" height="235" as="geometry" />
        </mxCell>
        <mxCell id="p9-n15" value="Somente administrador" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n14">
          <mxGeometry x="16" y="12" width="728" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n16" value="GET/POST /api/usuarios&#xa;PUT /api/usuarios/{id}&#xa;POST /api/usuarios/{id}/senha&#xa;PATCH /api/solicitacoes/{id}/status&#xa;POST /api/solicitacoes/{id}/analise" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n14">
          <mxGeometry x="16" y="54" width="728" height="171" as="geometry" />
        </mxCell>
        <mxCell id="p9-n17" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F0F3F5;strokeColor=#657786;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="570" width="755" height="235" as="geometry" />
        </mxCell>
        <mxCell id="p9-n18" value="Matriz de acesso: solicitante / administrador" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n17">
          <mxGeometry x="16" y="12" width="723" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n19" value="Catálogo de passageiros: próprio / próprio&#xa;Pedidos: próprios / todos&#xa;Análise e status: não / sim&#xa;Cancelamento: próprio / qualquer pedido aberto&#xa;Administração de usuários: não / sim" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n17">
          <mxGeometry x="16" y="54" width="723" height="171" as="geometry" />
        </mxCell>
        <mxCell id="p9-n20" value="" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#FFF5D8;strokeColor=#A77B16;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="925" width="1610" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p9-n21" value="Respostas e proteções comuns" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p9-n20">
          <mxGeometry x="16" y="12" width="1578" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p9-n22" value="400 JSON inválido • 401 sem sessão • 403 sem permissão • 404 inexistente ou alheio • 405 método incorreto&#xa;409 conflito / transição inválida • 413 corpo &gt;16 KiB • 415 tipo inválido • 419 CSRF • 422 validação • 429 limite • 503 serviço indisponível&#xa;Usuários ativos, perfil e assinatura da senha são conferidos pelo servidor; ocultar botões não é uma barreira de segurança." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p9-n20">
          <mxGeometry x="16" y="54" width="1578" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
