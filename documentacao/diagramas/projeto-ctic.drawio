        <mxCell id="p11-n6" value="Ambiente necessário" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#163E2A;" vertex="1" parent="p11-n5">
          <mxGeometry x="16" y="12" width="308" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p11-n7" value="PHP 8.1+ com PDO MySQL&#xa;MySQL com InnoDB e utf8mb4&#xa;Python 3.10+ para entrega/testes&#xa;draw.io para editar os diagramas" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p11-n5">
