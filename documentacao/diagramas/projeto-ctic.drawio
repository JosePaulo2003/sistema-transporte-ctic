        <mxCell id="p5-n3" value="O rascunho é da sessão; somente o envio final cria a viagem e seus passageiros no MySQL." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#56665F;fontStyle=0;spacing=0;" vertex="1" parent="1">
