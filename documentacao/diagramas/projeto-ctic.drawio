        <mxCell id="p4-n34" value="Sem sessão: API 401; página protegida redireciona para /entrar.&#xa;Conta desativada, senha redefinida ou logout invalidam o acesso." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Arial;spacingTop=2;fontColor=#263E31;" vertex="1" parent="p4-n32">
