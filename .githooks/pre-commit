#!/bin/sh
# Eu confiro o índice antes do commit: senha vazada não melhora meu salário.
if command -v python >/dev/null 2>&1; then
    exec python comandos/entrega.py --pre-commit
elif command -v python3 >/dev/null 2>&1; then
    exec python3 comandos/entrega.py --pre-commit
else
    echo 'Commit bloqueado: instale Python 3.10 ou superior para verificar a entrega.' >&2
    exit 1
fi
